# Server
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://fm.tabloza.live

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=followme
POSTGRES_USER=followme
POSTGRES_PASSWORD=change_me_strong_password

# JWT secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_DEVICE_SECRET=change_me_device_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Local storage path for recordings (mounted volume in docker-compose)
STORAGE_PATH=/data/recordings

# Firebase Cloud Messaging (optional, used to wake camera devices when
# the WebSocket connection has been killed by Android Doze/battery
# optimization). Leave empty to disable push-wake; commands will only be
# delivered while the device is connected over WebSocket.
FCM_SERVER_KEY=

# CORS: comma separated list of allowed origins (controller app / web admin)
CORS_ORIGINS=*
